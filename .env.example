NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
# Comma-separated list, or * for any origin
CORS_ORIGIN=*
LOG_LEVEL=info
# Number of reverse proxies in front of the app (0 = none, 1 = one LB/nginx, ...)
TRUST_PROXY=0
# fixed-window | sliding-window-log | sliding-window-counter | token-bucket | leaky-bucket
RATE_LIMIT_ALGORITHM=sliding-window-counter
# IPv6 clients are grouped by this prefix length
RATE_LIMIT_IPV6_SUBNET=64
# 3 requests per 1000ms (per second) per client
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX=3
# Optional: share rate limit state across instances via Redis/Valkey.
# Unset = in-memory. In docker compose this is set to redis://valkey:6379
# REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=200
SHUTDOWN_TIMEOUT_MS=10000
